# Copy to .env (gitignored) beside compose.yml.

# The public name the front proxy passes in Host; comma-separated for more.
# The loopback names are always answered, for the health check.
VRK_ALLOW_HOSTS=vrk.viespirkiai.org

# The shared external Docker network the front proxy is on.
VRK_NETWORK=proxy

# Who the container runs as: must read data/ and portraits/ and write
# dashboard/.
VRK_UID=1000
VRK_GID=1000

# Listen address and port inside the container (the image sets these). With
# `network_mode: host`, VRK_BIND=127.0.0.1 keeps the port off the outside.
#VRK_BIND=0.0.0.0
#VRK_PORT=8080
