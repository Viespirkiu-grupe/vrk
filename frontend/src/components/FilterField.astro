---
interface Props { id: string; label: string; title?: string; wide?: boolean; hint?: string; }
const { id, label, title = label, wide = false, hint } = Astro.props;
---
<div class:list={['filter-field', { 'filter-field-wide': wide }]}>
  <label for={id}>{label}</label>
  <select id={id} title={title} aria-describedby={hint ? `${id}-hint` : undefined}></select>
  {hint && <p id={`${id}-hint`} class="field-hint">{hint}</p>}
</div>
